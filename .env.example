APP_ENV=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/farmer_ai

JWT_SECRET_KEY=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_STORE=faiss
VECTOR_STORE_PATH=data/vector_store

TOP_K=5
SIMILARITY_THRESHOLD=0.70
CHUNK_SIZE=500
CHUNK_OVERLAP=50

TRANSLATION_PROVIDER=google
TRANSLATION_API_KEY=

STT_PROVIDER=openai
STT_API_KEY=

TTS_PROVIDER=google
TTS_API_KEY=

DISEASE_MODEL_PATH=
DISEASE_CONFIDENCE_THRESHOLD=0.70

MAX_IMAGE_SIZE_MB=10
MAX_AUDIO_SIZE_MB=25
UPLOAD_DIR=uploads

MOCK_MODE=true
ALLOW_ANONYMOUS_QUERY=true

WEATHER_PROVIDER=
WEATHER_API_KEY=
